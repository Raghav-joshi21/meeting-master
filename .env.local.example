# Set ONE key. Priority: NVIDIA → Anthropic → Vercel AI Gateway.
# Free key: https://build.nvidia.com (open any model → "Get API Key")
NVIDIA_API_KEY=
# Optional: any chat model id from build.nvidia.com
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=

# Password for the /notes login. Escape $ as \$ in this file.
NOTES_PASSWORD=
# Optional: stronger model for the end-of-meeting pass
NVIDIA_FINAL_MODEL=nvidia/nemotron-3-super-120b-a12b
